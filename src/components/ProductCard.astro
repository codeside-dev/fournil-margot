---
import { Image } from "astro:assets";

interface Props {
  slug: string;
  image: ImageMetadata;
  categorie: string;
  categorieSlug: string;
  name: string;
  description: string;
  price: string;
}

const { slug, image, categorie, categorieSlug, name, description, price } =
  Astro.props;
---

<article
  data-categorie={categorieSlug}
  class="relative flex h-full flex-col gap-4 rounded-2xl border border-[var(--color-line)] bg-white p-[18px] transition hover:border-[var(--color-line-soft)]"
>
  <div class="overflow-hidden rounded-xl bg-[var(--color-band)]">
    <Image
      src={image}
      alt={name}
      widths={[420, 640, 840]}
      sizes="(min-width: 1024px) 400px, (min-width: 640px) 45vw, 90vw"
      class="h-[150px] w-full object-cover"
      loading="lazy"
    />
  </div>

  <div class="flex flex-1 flex-col gap-2.5">
    <p
      class="font-mono text-[11px] font-semibold tracking-[1px] text-[var(--color-accent)]"
    >
      {categorie}
    </p>
    <h3 class="font-display text-[21px] font-semibold leading-tight">
      {/* Le lien couvre toute la carte : le bouton reste cliquable car il
          repasse au-dessus avec z-10 et position relative. */}
      <a
        href={`/produit/${slug}`}
        class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
      >
        {name}
      </a>
    </h3>
    <p class="text-sm leading-relaxed text-[var(--color-muted)]">
      {description}
    </p>
  </div>

  <div class="flex items-center justify-between">
    <span class="text-lg font-semibold">{price}</span>
    <button
      type="button"
      class="relative z-10 rounded-lg bg-[var(--color-accent)] px-4 py-2 text-[13px] font-semibold text-white transition hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
    >
      Ajouter
    </button>
  </div>
</article>
